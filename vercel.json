{
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://widely-lawrence-george-wax.trycloudflare.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://widely-lawrence-george-wax.trycloudflare.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://widely-lawrence-george-wax.trycloudflare.com/openapi.json"
    }
  ]
}
